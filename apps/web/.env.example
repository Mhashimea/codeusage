# Database — local Postgres via `docker-compose up -d` (see docker-compose.yml for user/password/db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/afterburn"

# Auth (NextAuth v5) — generate both with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3003"
APP_URL="http://localhost:3003"

# API key encryption — must be 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=""

# Email (Resend) — leave unset for local dev; OTP codes are logged to the server console instead
# RESEND_API_KEY=""
# EMAIL_FROM=""

# GitHub OAuth login — optional; create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:3003/api/auth/callback/github
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
