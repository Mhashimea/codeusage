{
  "name": "codeusage-cli",
  "version": "0.1.10",
  "description": "CLI for CodeUsage - AI coding tool intelligence platform",
  "author": "Hashim",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codeusage": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pack:tarball": "bun run build && npm pack"
  },
  "dependencies": {
    "@inquirer/input": "^5.0.10",
    "@inquirer/select": "^5.1.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "diff": "^8.0.4",
    "execa": "^9.5.2",
    "ora": "^8.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@codeusage/shared": "workspace:*",
    "@types/diff": "^8.0.0",
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
